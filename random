

#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int main()
{
    pid_t pid, wpid;

    pid = fork();

    if (pid == 0)
    {
        printf("Child process running\n");
    }
    else
    {
        printf("Child PID from fork = %d\n", pid);

        wpid = wait(NULL);

        printf("PID returned by wait = %d\n", wpid);

        if (pid == wpid)
            printf("Both PIDs are equal\n");
        else
            printf("Both PIDs are not equal\n");
    }

    return 0;
}
