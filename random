
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

int main()
{
    pid_t pid;
    int status;

    pid = fork();

    if (pid == 0)
    {
        printf("Child process is running\n");
        exit(5);
    }
    else if (pid > 0)
    {
        wait(&status);

        printf("Parent process is running\n");

        if (WIFEXITED(status))
        {
            printf("Child exit code: %d\n",
                   WEXITSTATUS(status));
        }
    }
    else
    {
        printf("Fork failed\n");
    }

    return 0;
}
