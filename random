#include <stdio.h>
#include <unistd.h>

int main(void)
{
    pid_t pid = fork();

    if (pid == -1) {
        perror("fork");
        return 1;
    }

    if (pid == 0)
        printf("Child: PID = %ld\n", (long)getpid());
    else
        printf("Parent: child PID = %ld\n", (long)pid);

    return 0;
}